{
  "name": "dsh-image-hub",
  "version": "0.1.0",
  "description": "DSH 多 API 生图插件 —— 一套 provider 抽象，原生支持 Labnana、OpenAI 兼容、Gemini、Seedream、DashScope、ComfyUI。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "image-generation",
    "labnana",
    "openai-compatible",
    "gemini",
    "seedream",
    "dashscope",
    "comfyui"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\""
  },
  "license": "MIT"
}
